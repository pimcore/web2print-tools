{
  "name": "pimcore/web2print-tools-bundle",
  "type": "pimcore-bundle",
  "license": "proprietary",
  "config": {
    "sort-packages": true
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": "~8.3.0 || ~8.4.0",
    "pimcore/admin-ui-classic-bundle": "^2.0",
    "pimcore/pimcore": "^12.3",
    "pimcore/output-data-config-toolkit-bundle": "^6.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.12.15"
  },
  "autoload": {
    "psr-4": {
      "Web2PrintToolsBundle\\": "src/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-6.x": "6.1.x-dev"
    },
    "pimcore": {
      "bundles": [
        "Web2PrintToolsBundle\\Web2PrintToolsBundle"
      ]
    }
  }
}
